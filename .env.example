# PostgreSQL (Neon, Supabase o Vercel Postgres)
DATABASE_URL=postgresql://usuario:contraseña@host/base?sslmode=require

# Secreto largo y aleatorio para firmar la sesión administrativa
ADMIN_SESSION_SECRET=cambiame-por-un-secreto-largo

# Se usan solo al ejecutar npm run seed para crear el primer administrador
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=cambiame-por-una-clave-segura

# URL pública usada en enlaces de recuperación
APP_URL=http://localhost:3000

# Email transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM=
ENROLLMENT_NOTIFICATION_TO=
ENROLLMENT_NOTIFICATION_CC=
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=

# Protege el endpoint llamado por Vercel Cron
CRON_SECRET=
